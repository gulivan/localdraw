{
  "name": "excalidash-desktop",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "dev": "npm run prepare:app && electrobun dev",
    "build": "npm run prepare:app && electrobun build --env=stable",
    "build:canary": "npm run prepare:app && electrobun build --env=canary",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:runtime": "npm run prepare:app && node scripts/run-electrobun-bun.mjs scripts/filesystem-workspace-smoke.ts && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.1",
    "typescript": "~5.9.3"
  }
}
